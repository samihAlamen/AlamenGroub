
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="text-center mb-4">تسجيل الدخول</h2>

        <form action="/auth/login" method="POST">
            <div class="mb-3">
                <label for="email" class="form-label">البريد الإلكتروني</label>
                <input type="email" class="form-control" id="email" name="email" required placeholder="ادخل بريدك الإلكتروني">
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">كلمة المرور</label>
                <input type="password" class="form-control" id="password" name="password" required placeholder="ادخل كلمة المرور">
            </div>

            <button type="submit" class="btn btn-primary w-100">تسجيل الدخول</button>
        </form>

        <p class="mt-3 text-center">
            ليس لديك حساب؟ <a href="/auth/register">إنشاء حساب جديد</a>
        </p>
    </div>
</div>
