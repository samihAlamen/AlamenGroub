<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>دردشة مع الطالب: <%= conversation.user.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="admin-chat-container">
    <h2>دردشة مع الطالب: <%= conversation.user.name %></h2>
    
    <div id="chat-box">
      <div class="messages">
        <% conversation.messages.forEach(function(message) { %>
          <div class="message <%= message.sender === 'admin' ? 'admin' : 'user' %>">
            <span><%= message.content %></span>
            <small><%= formatDate(message.sentAt) %></small>
          </div>
        <% }) %>
      </div>

      <!-- مربع النص لإرسال الرد -->
      <textarea id="message-input" placeholder="اكتب ردك هنا..."></textarea>
      <button id="send-btn">إرسال</button>
    </div>
  </div>

  <script src="https://cdn.socket.io/4.0.1/socket.io.min.js"></script>
  <script>
    const socket = io();
    const userId = "<%= conversation.user.id %>";  // المستخدم الذي تم تحديده للمحادثة

    // بدء الدردشة
    socket.emit('start-chat', userId);

    // عندما يضغط الادمن على زر إرسال
    document.getElementById('send-btn').addEventListener('click', () => {
      const message = document.getElementById('message-input').value;
      if (message) {
        socket.emit('send-message', { 
          userId, 
          message, 
          sender: 'admin'  // لأن الادمن هو الذي يرسل الرد
        });
        document.getElementById('message-input').value = '';  // مسح محتوى حقل النص
      }
    });

    // استقبال الرسائل من الخادم
    socket.on('receive-message', (message) => {
      const messageElement = document.createElement('div');
      messageElement.className = message.sender === 'admin' ? 'message admin' : 'message user';
      messageElement.innerHTML = `
        <span>${message.content}</span>
        <small>${message.sentAt}</small>
      `;
      document.querySelector('.messages').appendChild(messageElement);
    });
  </script>
</body>
</html>

