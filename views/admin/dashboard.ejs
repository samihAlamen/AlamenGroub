<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="container mt-4">
        <h1>لوحة تحكم الأدمن</h1>

        <!-- عرض الرسم البياني -->
        <div class="mt-4">
            <canvas id="scholarshipsChart"></canvas>
        </div>

        <a href="/admin/scholarships" class="btn btn-primary mt-4">إدارة المنح</a>
        <a href="/admin/applications" class="btn btn-secondary ms-2 mt-4">طلبات الطلاب</a>
        <a href="/chat/<%= profileUser && profileUser._id ? profileUser._id : '#' %>" class="btn btn-sm btn-secondary mt-4">💬 Chat</a>
    </div>

    <script>
        // بيانات الرسم البياني (يتم إحضارها من الـ Controller في Express)
        const chartData = <%- JSON.stringify(chartData) %>;

        // إعداد الرسم البياني
        const ctx = document.getElementById('scholarshipsChart').getContext('2d');
        const scholarshipsChart = new Chart(ctx, {
            type: 'bar',  // نوع الرسم البياني (مخطط شريطي)
            data: {
                labels: chartData.labels,  // التصنيفات (مثل "المنح المتاحة" و "المنح المنتهية")
                datasets: [{
                    label: 'عدد المنح الدراسية',
                    data: chartData.data,  // البيانات الفعلية (عدد المنح في كل فئة)
                    backgroundColor: ['rgba(75, 192, 192, 0.2)', 'rgba(255, 99, 132, 0.2)'],  // ألوان الأعمدة
                    borderColor: ['rgba(75, 192, 192, 1)', 'rgba(255, 99, 132, 1)'],  // حدود الأعمدة
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true  // بدء المحور Y من 0
                    }
                }
            }
        });
    </script>
</body>
</html>
