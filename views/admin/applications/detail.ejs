<div class="container mt-4">
  <h2>تفاصيل الطلب</h2>

  <h5>الطالب</h5>
  <p>
    <strong><%= application.user?.name || "غير متوفر" %></strong>
    – <%= application.user?.email || "غير متوفر" %>
  </p>

  <h5>المنحة</h5>
  <p><%= application.scholarship?.title || "غير متوفر" %></p>
  <p><%= application.scholarship?.description || "غير متوفر" %></p>
  <p><strong>المتطلبات:</strong></p>
  <ul>
    <% application.scholarship?.requirements.forEach(req => { %>
      <li><%= req %></li>
    <% }) %>
  </ul>

  <p><strong>المستندات المطلوبة:</strong></p>
  <ul>
    <% application.scholarship?.documents.forEach(doc => { %>
      <li><%= doc %></li>
    <% }) %>
  </ul>

  <p><strong>الموعد النهائي:</strong> <%= application.scholarship?.deadline.toDateString() || "غير متوفر" %></p>

  <hr>

  <% if (Array.isArray(application.scholarship?.steps?.steps)) { %>
    <h4>الخطوات</h4>
    <% application.scholarship.steps.steps.forEach((step, index) => { %>
      <h5><%= step.title || "عنوان الخطوة غير متوفر" %></h5>
      <p><%= step.description || "وصف الخطوة غير متوفر" %></p>

      <h6>إجابة الطالب:</h6>
      <% let stepAnswer = application.stepsAnswers.find(sa => sa.step === `step_${index + 1}`); %>
      <p><%= stepAnswer ? stepAnswer.answer : "لا يوجد إجابة" %></p>

      <hr>
    <% }) %>
  <% } else { %>
    <p class="text-muted">لا توجد خطوات لهذه المنحة</p>
  <% } %>

  <hr>

  <% if (application.status === "pending") { %>
    <form method="POST" action="/admin/applications/<%= application._id %>/approve" style="display:inline">
      <button class="btn btn-success">قبول</button>
    </form>

    <form method="POST" action="/admin/applications/<%= application._id %>/reject" style="display:inline">
      <button class="btn btn-danger">رفض</button>
    </form>
  <% } %>
</div>
