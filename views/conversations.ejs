<h2>Conversations</h2>
<div class="conversations-list">
  <% conversations.forEach(conversation => { %>
    <div class="conversation">
      <a href="/chat/<%= conversation.participants.find(p => p._id.toString() !== user.id.toString())._id %>">
        <img src="<%= conversation.participants.find(p => p._id.toString() !== user.id.toString()).avatar %>" alt="User Avatar" class="avatar" />
        <span><%= conversation.participants.find(p => p._id.toString() !== user.id.toString()).username %></span>
      </a>
    </div>
  <% }) %>
</div>
