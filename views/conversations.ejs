<h2>Conversations</h2>
<div class="conversations-list">
  <% if (user.role === 'admin') { %>
    <% conversations.forEach(conversation => { %>
      <div class="conversation">
        <a href="/chat/<%= conversation.participants.find(p => p.user._id.toString() !== user.id.toString()).user._id %>">
          <img src="<%= conversation.participants.find(p => p.user._id.toString() !== user.id.toString()).user.avatar %>" alt="User Avatar" class="avatar" />
          <span><%= conversation.participants.find(p => p.user._id.toString() !== user.id.toString()).user.username %></span>
        </a>
      </div>
    <% }) %>
  <% } else { %>
    <a href="/chat/<%= user.id %>" class="btn btn-primary">Chat with Admin</a>
  <% } %>
</div>
