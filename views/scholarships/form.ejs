
<h1 class="text-center mb-4">تقديم طلب للمنحة: <%= scholarship.title %></h1>

<form id="application-form" action="/applications/apply/<%= scholarship._id %>" method="POST" enctype="multipart/form-data">
    <!-- Step 1: Personal Information -->
    <div class="step" id="step-1">
        <h3>المعلومات الشخصية</h3>
        <div class="mb-3">
            <label for="fullName" class="form-label">الاسم الكامل</label>
            <input type="text" class="form-control" id="fullName" name="fullName" required placeholder="أدخل اسمك الكامل">
        </div>
        <div class="mb-3">
            <label for="passportNumber" class="form-label">رقم جواز السفر</label>
            <input type="text" class="form-control" id="passportNumber" name="passportNumber" required placeholder="أدخل رقم جواز السفر">
        </div>
        <button type="button" class="btn btn-primary" onclick="nextStep(1)">التالي</button>
    </div>

    <!-- Step 2: Upload Documents -->
    <div class="step" id="step-2" style="display: none;">
        <h3>رفع المستندات</h3>
        <div class="mb-3">
            <label for="passport" class="form-label">جواز السفر</label>
            <input type="file" class="form-control" id="passport" name="passport" required>
        </div>
        <div class="mb-3">
            <label for="certificate" class="form-label">الشهادة الدراسية</label>
            <input type="file" class="form-control" id="certificate" name="certificate[]" multiple required>
        </div>
        <button type="button" class="btn btn-secondary" onclick="previousStep(2)">العودة</button>
        <button type="button" class="btn btn-primary" onclick="nextStep(2)">التالي</button>
    </div>

    <!-- Step 3: Payment Information -->
    <div class="step" id="step-3" style="display: none;">
        <h3>معلومات الدفع</h3>
        <p>يرجى ملاحظة أن الدفع يتم داخل المكتب في إسطنبول.</p>
        <button type="button" class="btn btn-secondary" onclick="previousStep(3)">العودة</button>
        <button type="submit" class="btn btn-success">إرسال الطلب</button>
    </div>
</form>

<script>
    let currentStep = 1;
    const totalSteps = 3;

    function showStep(step) {
        for (let i = 1; i <= totalSteps; i++) {
            const stepElement = document.getElementById('step-' + i);
            stepElement.style.display = (i === step) ? 'block' : 'none';
        }
    }

    function nextStep(step) {
        if (step < totalSteps) {
            currentStep = step + 1;
            showStep(currentStep);
        }
    }

    function previousStep(step) {
        if (step > 1) {
            currentStep = step - 1;
            showStep(currentStep);
        }
    }

    showStep(currentStep);
</script>
