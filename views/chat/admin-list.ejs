<%- include('../layouts/main') %>

<h3>قائمة المحادثات</h3>
<ul>
    <% conversations.forEach(conv => { %>
        <li>
            <a href="/admin/chat/<%= conv._id %>">
                محادثة مع 
                <% conv.participants.forEach(p => { if(p.role === 'student'){ %>
                    <%= p.name %>
                <% }}) %>
            </a>
        </li>
    <% }) %>
</ul>
